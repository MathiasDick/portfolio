---
import { type CollectionEntry, getCollection, render } from "astro:content";

import ContactCTA from "../../components/ContactCTA.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import Pill from "../../components/Pill.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"work">;
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/guides/routing/#dynamic-routes
export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="stack gap-20">
    <div class="stack gap-15">
      <header>
        <div class="project-header stack gap-2">
          <a class="back-link" href="/work/"><Icon icon="arrow-left" /> Work</a>
          <Hero title={entry.data.title} align="start">
            <div class="details">
              <div class="tags">
                {entry.data.tags.map((t) => <Pill>{t}</Pill>)}
              </div>
              <p class="description">{entry.data.description}</p>
            </div>
          </Hero>
        </div>
      </header>
      <main class="project-content">
        <div class="stack gap-10">
          {
            entry.data.img && (
              <img
                src={entry.data.img}
                alt={entry.data.img_alt || ""}
                class="hero-image"
              />
            )
          }
          <div class="content">
            <Content />
          </div>
        </div>
      </main>
    </div>
    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .project-header {
    width: 100%;
    max-width: 100rem;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .project-content {
    width: 100%;
    max-width: 100rem;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--gray-800);
  }

  .back-link {
    display: none;
  }

  .details {
    display: flex;
    flex-direction: column;
    padding: 0.5rem;
    gap: 1.5rem;
    justify-content: space-between;
    align-items: center;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
  }

  .description {
    font-size: var(--text-lg);
    max-width: 54ch;
  }

  .hero-image {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
    display: block;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  .content {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
  }

  .content :global(pre.mermaid) {
    max-width: 100%;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .content :global(pre.mermaid:hover) {
    opacity: 0.8;
  }

  .diagram-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    padding: 2rem;
    overflow: auto;
  }

  .diagram-modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .diagram-modal-content {
    max-width: 95vw;
    max-height: 95vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    padding: 2rem;
    border-radius: 1rem;
    overflow: auto;
  }

  .diagram-modal-content :global(svg) {
    width: 85vw !important;
    height: auto !important;
  }

  .diagram-modal-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    background: var(--accent-regular);
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 1.25rem;
    cursor: pointer;
    border-radius: 0.5rem;
    z-index: 10000;
  }

  .diagram-modal-close:hover {
    background: var(--accent-dark);
  }

  .content > :global(* + *) {
    margin-top: 1rem;
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3),
  .content :global(h4),
  .content :global(h5) {
    margin: 1.5rem 0;
  }

  .content :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 30rem;
    margin-inline: auto;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-sm);
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
  }

  .content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: 2rem;
  }

  .content :global(th),
  .content :global(td) {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--gray-800);
  }

  .content :global(th) {
    font-weight: 600;
    color: var(--gray-0);
    border-bottom: 2px solid var(--gray-800);
  }

  /* Remove border from last row */
  .content :global(tr:last-child td) {
    border-bottom: none;
  }

  .content :global(table img) {
    display: block;
    width: auto;
    max-width: 100%;
    margin-inline: auto;
  }

  .content :global(blockquote) {
    font-size: var(--text-lg);
    font-family: var(--font-brand);
    font-weight: 600;
    line-height: 1.1;
    padding-inline-start: 1.5rem;
    border-inline-start: 0.25rem solid var(--accent-dark);
    color: var(--gray-0);
  }

  .back-link,
  .content :global(a) {
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .back-link:hover,
  .back-link:focus,
  .content :global(a:hover),
  .content :global(a:focus) {
    text-decoration-color: currentColor;
  }

  @media (min-width: 50em) {
    .project-header {
      padding-inline: 3rem;
    }

    .project-content {
      padding-inline: 3rem;
    }

    .back-link {
      display: block;
      align-self: flex-start;
    }

    .details {
      flex-direction: row;
      gap: 2.5rem;
    }

    .content :global(blockquote) {
      font-size: var(--text-2xl);
    }
  }

  @media (min-width: 90em) {
    .project-header {
      padding-inline: 4rem;
    }

    .project-content {
      padding-inline: 4rem;
    }
  }
</style>

<div class="diagram-modal" id="diagramModal">
  <button class="diagram-modal-close" id="closeModal">Close ✕</button>
  <div class="diagram-modal-content" id="modalContent"></div>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var modal = document.getElementById("diagramModal");
    var modalContent = document.getElementById("modalContent");
    var closeBtn = document.getElementById("closeModal");

    console.log("Modal script loaded", modal, modalContent);

    // Use event delegation on document
    document.addEventListener("click", function (e) {
      var target = e.target;
      // Walk up the DOM to find a pre.mermaid
      while (target && target !== document) {
        if (target.tagName === "PRE" && target.classList.contains("mermaid")) {
          console.log("Mermaid diagram clicked!");
          var svg = target.querySelector("svg");
          console.log("SVG found:", svg);
          if (!svg) return;

          var wrapper = document.createElement("div");
          wrapper.innerHTML = svg.outerHTML;
          var insertedSvg = wrapper.querySelector("svg");
          if (insertedSvg) {
            insertedSvg.removeAttribute("width");
            insertedSvg.removeAttribute("height");
            insertedSvg.removeAttribute("style");
            insertedSvg.style.maxWidth = "85vw";
            insertedSvg.style.maxHeight = "85vh";
            insertedSvg.style.width = "85vw";
            insertedSvg.style.height = "auto";
          }

          modalContent.innerHTML = "";
          modalContent.appendChild(wrapper);
          modal.classList.add("active");
          return;
        }
        target = target.parentElement;
      }
    });

    closeBtn.addEventListener("click", function () {
      modal.classList.remove("active");
    });

    modal.addEventListener("click", function (e) {
      if (e.target === modal) {
        modal.classList.remove("active");
      }
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && modal.classList.contains("active")) {
        modal.classList.remove("active");
      }
    });
  });
</script>
